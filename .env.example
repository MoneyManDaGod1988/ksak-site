# Copy to .env (or set as host environment variables) and fill in real values.
PORT=3000
NODE_ENV=production
# Long random string; sessions are server-side tokens, this is reserved for cookie signing.
SESSION_SECRET=change-me-to-a-long-random-string
# Directory containing the 5 TRIAL installers (exact file names in src/server.js PLUGINS list).
DOWNLOADS_DIR=/app/downloads
# SQLite database file — put it on a PERSISTENT volume or accounts are lost on redeploy.
DB_PATH=/app/data/ksak.db
